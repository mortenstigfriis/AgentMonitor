limit_req_zone $binary_remote_addr zone=talifly_mc_general:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=talifly_mc_login:10m rate=5r/m;

server {
    listen 80;
    listen [::]:80;
    server_name __MISSION_CONTROL_DOMAIN__;
    access_log off;
    error_log /var/log/nginx/talifly-mission-control-error.log warn;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/talifly-mission-control-acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location / { return 308 https://__MISSION_CONTROL_DOMAIN__$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __MISSION_CONTROL_DOMAIN__;
    ssl_certificate /etc/letsencrypt/live/__MISSION_CONTROL_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__MISSION_CONTROL_DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log /var/log/nginx/talifly-mission-control-access.log;
    error_log /var/log/nginx/talifly-mission-control-error.log warn;
    client_max_body_size 32k;

    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header Cache-Control "private, no-store" always;

    location = /api/auth/login {
        limit_req zone=talifly_mc_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:3456;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
    }

    location / {
        limit_req zone=talifly_mc_general burst=40 nodelay;
        proxy_pass http://127.0.0.1:3456;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
    }
}
